# Legacy filename retained as a pointer. Copy `.dev.vars.example` to `.dev.vars`
# for local Workers development. Production secrets are set with `wrangler secret put`.
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_API_KEY=replace-with-at-least-32-random-characters
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
