    <string name="delete_account">Delete account and data</string>
    <string name="delete_account_confirm">Delete permanently</string>
    <string name="delete_account_explanation">This deletes the signed-in cloud account, if any, and clears all app data on this installation. Local-only mode deletes device data. The app will close. This cannot be undone.</string>
    <string name="backup_device_notice">Encrypted cloud backups can be restored only while this device retains its encryption keys. They cannot recover data after reinstall, clearing app storage, or moving to a new phone. Export any evidence you need before removing the app.</string>
    <string name="message_contacts">Prepare SMS for trusted contacts</string>
